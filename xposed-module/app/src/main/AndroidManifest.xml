<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Private Space unlock permissions (granted when installed as priv-app via Magisk) -->
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="PrivateSpaceMod"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true">

        <!-- LSPosed metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Private Space: double-tap unlock, label hider, app picker" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:value="com.google.android.apps.nexuslauncher" />

        <!-- Quick Settings Tile (backup unlock trigger) -->
        <service
            android:name=".PrivateSpaceTileService"
            android:label="Private Space"
            android:icon="@drawable/ic_private_space"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
